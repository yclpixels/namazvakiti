# FAZ 6.3 — Force HTTPS + WWW canonicalization NOT implemented here.
# Cloudflare Pages _redirects only accepts relative-path sources; absolute-URL
# sources (http://namazvakiti.net/*, https://namazvakiti.net/*, http://www...)
# are rejected outright ("Only relative URLs are allowed" — verified via
# `wrangler pages dev` against this exact file in FAZ 6.2/6.3). This must be
# implemented via Cloudflare "Redirect Rules" (Bulk Redirects) at the
# zone/dashboard level once the custom domain is connected (FAZ 7+), not here.
# Netlify (current production) continues to enforce its own HTTPS/WWW
# canonicalization independently of this file — verify Netlify's site-level
# "Force HTTPS" / primary-domain setting before relying on it, since the
# absolute-URL _redirects lines that used to (also) cover this on Netlify
# were removed from this shared file as part of this fix.


# Allow static files to bypass SPA fallback
/ads.txt    /ads.txt    200
/robots.txt /robots.txt 200
/sitemap.xml /sitemap.xml 200
/google30951a8846720cf2.html /google30951a8846720cf2.html 200

# Kök seviyesindeki gerçek proje klasörleri — asagidaki tek-segment
# wildcard'in bunlari yanlislikla var olmayan bir .html'e yönlendirmesini
# engeller (wildcard'dan ONCE gelmeli, ilk eslesen kural kazanir)
/assets/    /assets/    200
/docs/    /docs/    200
/tools/    /tools/    200


# Eski klasör-tipi il/statik-sayfa sayfalarindan duz URL'e yonlendirme
# (duplicate icerik temizligi). Tek bir dinamik (placeholder) kural, önceki
# 87 ayri statik kuralin yerine gecti — Cloudflare Pages _redirects icin
# _redirects basina en fazla 100 dinamik kural destegi var; bu tek kural o
# butceyi pratik olarak hic kullanmiyor. Sadece TEK segmentli yollari
# eslestirir (/istanbul/ eslesir, /istanbul/sisli/ ESLESMEZ) — dogrulandi.
/:slug/    /:slug.html    301


