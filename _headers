# Site geneli güvenlik header'ları
# Not: script-src/style-src 'unsafe-inline' içeriyor çünkü site 404 statik
# HTML dosyasında (JSON-LD structured data, gtag/AdSense init script'i)
# build-time nonce/hash altyapısı olmadan inline script/style kullanıyor.
# 'unsafe-inline' kaldırılırsa FAQPage structured data ve analytics/reklam
# script'leri tüm sayfalarda kırılır. Diğer direktifler (connect/img/frame-src)
# gerçekten kullanılan üçüncü taraf kaynaklarla sıkı şekilde sınırlandırıldı.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://pagead2.googlesyndication.com https://www.google-analytics.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.googleusercontent.com https://www.google-analytics.com https://*.googlesyndication.com https://*.g.doubleclick.net; font-src 'self'; connect-src 'self' https://ezanvakti.emushaf.net https://overpass-api.de https://nominatim.openstreetmap.org https://www.google-analytics.com https://region1.google-analytics.com https://pagead2.googlesyndication.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.alquran.cloud; frame-src https://*.googlesyndication.com https://*.doubleclick.net; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Cache: Cloudflare Pages, eslesen TUM _headers kurallarini BIRLESTIRIR
# (daha spesifik olan ezmez) — dogrulandi: /assets/* + /assets/style.css birlikte
# tanimlandiginda deger "max-age=0, ..., max-age=31536000, immutable" olarak
# birlesiyor. Bu yuzden kurallar CAKISMAYACAK sekilde ayrildi.
# style.css'in URL'sinde hash/version yok; immutable kalirsa yeni tasarim eski
# ziyaretcilere 1 yil boyunca ulasmaz. Gorseller zaten -v2 ile elle surumlendigi
# icin onlar immutable kalabilir.
/assets/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Renkli ikon seti: dosya adları sürümsüz, immutable değil
/assets/icons/nv/*
  Cache-Control: public, max-age=2592000

/assets/*.json
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
